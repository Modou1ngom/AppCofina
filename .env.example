APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# database = jobs en BDD, à traiter avec: php artisan queue:work
# sync = envoi immédiat (pas de worker nécessaire, utile en dev)
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Envoi des emails : log = écrit dans storage/logs uniquement, smtp = envoi réel
# Pour recevoir les notifications (habilitations, etc.), mettez MAIL_MAILER=smtp et configurez ci-dessous
# Si QUEUE_CONNECTION=database, lancez un worker : php artisan queue:work
MAIL_MAILER=smtp
MAIL_HOST=smtp.office365.com
MAIL_PORT=587
MAIL_USERNAME=votre-email@cofinacorp.com
MAIL_PASSWORD=votre-mot-de-passe-ou-mot-de-passe-d-application
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=votre-email@cofinacorp.com
MAIL_FROM_NAME="${APP_NAME}"