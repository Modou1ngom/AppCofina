APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Création automatique d'un compte User lors de l'enrôlement d'un profil (même e-mail)
COFINA_PROVISION_USER_ON_PROFIL=true
COFINA_DEFAULT_USER_PASSWORD=Cofina@2025
COFINA_EMAIL_DOMAIN=cofinacorp.com
# false = uniquement les e-mails du fichier Excel (recommandé)
COFINA_IMPORT_GENERATE_EMAIL=false

# Compte super admin (php artisan db:seed --class=SuperAdminUserSeeder)
SUPERADMIN_NAME="Super Admin"
SUPERADMIN_EMAIL=superadmin@cofina.sn
SUPERADMIN_PASSWORD=
# SUPERADMIN_MUST_CHANGE_PASSWORD=true
# SUPERADMIN_RESET_PASSWORD=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel

# DB_USERNAME=root
# DB_PASSWORD=

# --- Proxy Oracle (Python) : recommandé en local (PHP sans extension oci8) ---
# composer.json déclare ext-oci8 en platform pour composer install ; en prod Oracle
# direct, installez oci8 + Instant Client sur le serveur PHP.
# Laravel appelle ce service HTTP ; Python utilise oracledb + Instant Client.
# SIG_ORACLE_HTTP_ENABLED=true
# SIG_ORACLE_HTTP_BASE_URL=http://127.0.0.1:8810
# SIG_ORACLE_HTTP_TOKEN=
# SIG_ORACLE_HTTP_TIMEOUT=30
# SIG_ORACLE_HTTP_VERIFY_SSL=true
# SIG_ORACLE_HTTP_LOOKUP_PERSONNEL_PATH=/api/sig/lookup-personnel
# SIG_ORACLE_HTTP_STAFF_LIEES_PATH=/api/sig/staff/{matricule}/personnes-liees

# Oracle REPORT_GROUPE — utilisé par le proxy Python (.env chargé depuis scripts/oracle-proxy-python)
# et optionnellement par PHP si oci8 + ORACLE_REPORT_GROUPE_LOOKUP_ENABLED
# ORACLE_REPORT_GROUPE_HOST=
# ORACLE_REPORT_GROUPE_PORT=1521
# ORACLE_REPORT_GROUPE_SERVICE_NAME=
# ORACLE_REPORT_GROUPE_USERNAME=
# ORACLE_REPORT_GROUPE_PASSWORD=
# ORACLE_REPORT_GROUPE_LOOKUP_ENABLED=false
# ORACLE_REPORT_GROUPE_LOOKUP_PERSONNEL_SQL=
# ORACLE_REPORT_GROUPE_STAFF_LIEES_SQL=
# Schéma Oracle (proxy Python) — ex. CFSFCUBS145
# ORACLE_CURRENT_SCHEMA=CFSFCUBS145
# Fichiers SQL (scripts/oracle-proxy-python/sql/) si vous ne mettez pas le SQL en une ligne dans .env
# ORACLE_LOOKUP_PERSONNEL_SQL_FILE=sql/kyc_by_customer.sql
# ORACLE_ENCOURS_SQL_FILE=sql/encours_client.sql

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# database = jobs en BDD, à traiter avec: php artisan queue:work
# sync = envoi immédiat (pas de worker nécessaire, utile en dev)
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Envoi des emails : log = écrit dans storage/logs uniquement, smtp = envoi réel
# Pour recevoir les notifications (habilitations, etc.), mettez MAIL_MAILER=smtp et configurez ci-dessous
# Si QUEUE_CONNECTION=database, lancez un worker : php artisan queue:work
MAIL_MAILER=smtp
MAIL_HOST=smtp.office365.com
MAIL_PORT=587
MAIL_USERNAME=votre-email@cofinacorp.com
MAIL_PASSWORD=votre-mot-de-passe-ou-mot-de-passe-d-application
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=votre-email@cofinacorp.com
MAIL_FROM_NAME="${APP_NAME}"